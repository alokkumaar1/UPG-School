// storage.rules
// Copy this content into Firebase Console > Storage > Rules

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow uploading admission documents (public form submission)
    match /admissions/{appId}/{fileName} {
      allow write: if request.resource.size < 5 * 1024 * 1024  // 5MB max
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType == 'application/pdf'
                   );

      // Only admins can read (for viewing submitted documents)
      allow read: if request.auth != null;
    }
  }
}
