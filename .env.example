# ============================================
# UPG+2 High School Admission Portal
# Environment Variables - Copy to .env file
# ============================================

# --- Firebase Configuration ---
# Get from: Firebase Console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- Razorpay Configuration ---
# Get from: Razorpay Dashboard > Settings > API Keys
# Use TEST keys during development, LIVE keys in production
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# --- Admin Panel ---
# Simple hardcoded credentials (change these!)
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=school@2024
